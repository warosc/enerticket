# =============================================================================
# Energuate Service Desk — variables de entorno de PRODUCCIÓN (plantilla)
#
# En el servidor, en la raíz del repositorio:
#   cp .env.production.example .env && chmod 600 .env
#   docker compose -f docker-compose.prod.yml config -q
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Sustituya TODOS los valores "replace-...": el servicio "preflight" (deploy/preflight.sh)
# impide arrancar si alguno conserva el valor de ejemplo, es trivial o tiene menos de 16
# caracteres. El archivo .env está en .gitignore:
# nunca lo suba al repositorio. Genere secretos aleatorios, por ejemplo:
#   openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40; echo
# Use solo letras y números en las contraseñas que van dentro de URLs
# (DB_PASSWORD, REDIS_PASSWORD).
#
# Valores FIJADOS por docker-compose.prod.yml (no se leen de aquí):
#   ENVIRONMENT=production, AUTH_MODE=oidc, SEED_DEMO=false, KC_LAB_USERS=false,
#   LDAP_ALLOW_INSECURE=false, NEXT_PUBLIC_AUTH_MODE=oidc, OIDC_AUDIENCE=servicedesk-api.
# Valores DERIVADOS de APP_DOMAIN: OIDC_ISSUER, OIDC_JWKS_URL, CORS_ORIGINS,
#   S3_PUBLIC_ENDPOINT, KC_HOSTNAME, KC_WEB_URLS y todas las NEXT_PUBLIC_*.
# =============================================================================

# --- Dominio y TLS -----------------------------------------------------------
# Dominio público único (sin https://). Debe resolver a este servidor.
APP_DOMAIN=replace-with-servicedesk.example.com
# acme     = certificado automático (requiere salida a Internet y puerto 80 accesible por la CA)
# files    = certificado corporativo en deploy/certs/tls.crt + tls.key (ver deploy/certs/README.md)
# internal = CA interna de Caddy (solo preproducción)
TLS_MODE=files
# Correo de contacto de la CA (obligatorio con TLS_MODE=acme).
ACME_EMAIL=replace-with-ops-email
# Carpeta del host con tls.crt / tls.key (TLS_MODE=files).
TLS_CERTS_DIR=./deploy/certs
# IP del host donde se publican 80/443 (0.0.0.0 = todas las interfaces).
PUBLIC_BIND_IP=0.0.0.0
# Redes autorizadas a /auth/admin y al realm master de Keycloak (separadas por espacio).
# 127.0.0.1/32 equivale a bloquear a todos: defina la VLAN de TI. Ej.: "10.10.20.0/24 10.10.30.15/32"
ADMIN_ALLOWED_CIDRS=127.0.0.1/32
# Tamaño máximo de una petición hacia la API / subida de adjuntos (mayor que MAX_ATTACHMENT_MB).
MAX_REQUEST_BODY=30MB
# Red interna "edge" y la IP fija de Caddy en ella (cámbielas si chocan con la LAN).
EDGE_SUBNET=10.250.250.0/24
CADDY_EDGE_IP=10.250.250.10

# --- Base de datos de la aplicación (PostgreSQL) ------------------------------
DB_PASSWORD=replace-with-strong-db-password

# --- Redis (broker de Celery y bus de eventos) ------------------------------
REDIS_PASSWORD=replace-with-strong-redis-password

# --- Keycloak ----------------------------------------------------------------
KC_DB_PASSWORD=replace-with-strong-keycloak-db-password
# Administrador bootstrap del realm master (solo se crea en el primer arranque).
# Tras el go-live cree un administrador nominal y elimine/deshabilite este.
KC_ADMIN=admin
KC_ADMIN_PASSWORD=replace-with-strong-keycloak-admin-password
KC_REALM=energuate
KC_LOG_LEVEL=info
# default | json (json facilita el envío a un SIEM)
KC_LOG_FORMAT=json
# Carpeta del host con la CA corporativa (LDAPS/StartTLS contra el AD).
KC_TRUSTSTORE_DIR=./keycloak/truststore
# Grupo (AD) -> rol de realm. Formato Grupo:rol separado por comas.
KC_GROUP_ROLE_MAP=GG-SD-Admins:admin,GG-SD-Agentes:agent,GG-SD-Aprobadores:approver

# --- Active Directory de Energuate (federación) -------------------------------
# Guía paso a paso: docs/AD_INTEGRATION.md. En producción solo se acepta
# ldaps:// o ldap:// con LDAP_START_TLS=true.
LDAP_URL=replace-with-ldaps://dc01.energuate.local:636
LDAP_BIND_DN=replace-with-service-account-dn
LDAP_BIND_CREDENTIAL=replace-with-service-account-password
LDAP_USERS_DN=replace-with-users-base-dn
LDAP_GROUPS_DN=replace-with-groups-base-dn
# Ej.: solo cuentas habilitadas
#   LDAP_USER_FILTER='(!(userAccountControl:1.2.840.113556.1.4.803:=2))'
LDAP_USER_FILTER='(!(userAccountControl:1.2.840.113556.1.4.803:=2))'
# Ej.: solo grupos del Service Desk
LDAP_GROUP_FILTER='(cn=GG-SD-*)'
LDAP_GROUPS_RECURSIVE=false
LDAP_START_TLS=false
LDAP_CONNECTION_TIMEOUT=10000
LDAP_READ_TIMEOUT=30000
LDAP_SEARCH_SCOPE=subtree
LDAP_PAGINATION=true
LDAP_BATCH_SIZE=500
LDAP_FULL_SYNC_PERIOD=86400
LDAP_CHANGED_SYNC_PERIOD=3600
LDAP_SYNC_USERS_ON_START=false
# Atributo LDAP con el departamento del usuario (Fase 3). Llega al portal como claim
# "department" y se traduce a un departamento con los «Valores del AD» de Administración.
# Vacío = no se mapea el departamento.
LDAP_DEPARTMENT_ATTRIBUTE=department

# --- Aplicación --------------------------------------------------------------
LOG_LEVEL=INFO
CELERY_LOG_LEVEL=info
# Procesos uvicorn de la API (≈ núcleos asignados a la API).
UVICORN_WORKERS=2
# Procesos de Celery por contenedor worker.
CELERY_CONCURRENCY=4
SEED_TEAM_GROUPS="Telecomunicaciones:GG-SD-Telecomunicaciones,Seguridad de Redes:GG-SD-SeguridadRedes,Ciberseguridad / SOC:GG-SD-SOC,Riesgo y Cumplimiento:GG-SD-Riesgo,Proyectos TI:GG-SD-ProyectosTI,General:GG-SD-General"
TZ_BUSINESS=America/Guatemala
# Política «Cambios» y reglas de automatización de ejemplo. false (recomendado): la etapa
# «Comité de cambios» de ejemplo es global (todos los aprobadores ven los tickets de cambio
# mientras su etapa está activa). Con true se siembran UNA sola vez: si luego se borran no
# reaparecen al reiniciar.
SEED_FLOWS_EXAMPLES=false
# Swagger/ReDoc/openapi.json (por defecto desactivados en producción).
API_DOCS=false
# Sin claim "groups" en el token = sin grupos (retira equipos mapeados). Recomendado true.
OIDC_MISSING_GROUPS_AS_EMPTY=true
# APP_PUBLIC_URL (enlaces de correos) se fija a https://APP_DOMAIN en docker-compose.prod.yml.
# WebSocket: WS_PING_INTERVAL_SECONDS=25, WS_QUEUE_SIZE=500, WS_MAX_CONNECTION_SECONDS=43200,
# WS_SEND_TIMEOUT_SECONDS=10, WS_VISIBILITY_CACHE_SECONDS=30, WS_REDIS_BACKOFF_MAX_SECONDS=30
# (valores por defecto; no requieren configuración).

# --- Catálogo, VIP y reportes (Fase 3) ----------------------------------------
# Grupo AD cuyos miembros son VIP (users.vip se actualiza en cada login; los tickets
# que crean quedan marcados como VIP y pueden tener su propio SLA «solo VIP»).
# keycloak-config crea el grupo en Keycloak si no existe.
VIP_GROUP=GG-SD-VIP
# Dominios permitidos para los destinatarios de reportes programados, separados por
# comas (máximo 20 destinatarios por plantilla). Si la variable no está definida, docker
# compose usa energuate.com; definida pero vacía (REPORT_RECIPIENT_DOMAINS=) = cualquier dominio.
REPORT_RECIPIENT_DOMAINS=energuate.com

# --- Límites anti-abuso (opcionales; valores por defecto recomendados) ---------
# Prioridad máxima que elige quien no es agente al crear un ticket (vacío = sin límite).
REQUESTER_MAX_PRIORITY=high
# Tickets por hora de un usuario que no es agente (0 = sin límite).
TICKETS_PER_USER_HOUR=30
# Cuota de adjuntos por usuario en 24 h (incluye borrados hasta su purga; admin exento).
ATTACHMENT_USER_DAILY_MB=500
ATTACHMENT_USER_DAILY_COUNT=100
# Días sin iniciar sesión tras los que una cuenta deja de recibir avisos y de ser
# elegible como aprobador/asignado (sus roles AD solo se sincronizan al entrar). 0 = nunca.
ACCOUNT_STALE_DAYS=45
# Un token con «kid» desconocido refresca el JWKS como mucho una vez cada N segundos.
OIDC_JWKS_MIN_REFRESH_SECONDS=60
# WebSocket: conexiones por usuario y proceso, mensajes entrantes por minuto y tamaño
# máximo de trama (lo aplica uvicorn --ws-max-size).
WS_MAX_CONNECTIONS_PER_USER=8
WS_CLIENT_MESSAGES_PER_MINUTE=60
WS_MAX_MESSAGE_BYTES=16384
# Longitud mínima de las contraseñas que exige deploy/preflight.sh (servicio "preflight").
PREFLIGHT_MIN_SECRET_LENGTH=16

# --- Adjuntos (MinIO) ----------------------------------------------------------
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-root-password
# Cuenta de servicio de la API, limitada al bucket (la crea minio-init).
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-strong-s3-secret-key
S3_BUCKET=servicedesk-attachments
S3_REGION=us-east-1
MAX_ATTACHMENT_MB=20
# Días que se conservan en MinIO los adjuntos borrados antes de purgarlos (0 = nunca).
ATTACHMENT_PURGE_DAYS=30

# --- Correo (notificaciones) -------------------------------------------------
# SMTP_HOST vacío = notificaciones solo dentro de la aplicación.
SMTP_HOST=replace-with-smtp-relay.energuate.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=replace-with-servicedesk@energuate.com
SMTP_STARTTLS=true

# --- Portal web ----------------------------------------------------------------
# Orígenes extra para la CSP del portal (separados por espacio; normalmente vacío).
NEXT_PUBLIC_CSP_EXTRA_SOURCES=

# --- Imágenes (opcional: registro corporativo / versiones fijadas) -----------
# BACKEND_IMAGE=registry.energuate.local/servicedesk/backend:1.0.0
# WEB_IMAGE=registry.energuate.local/servicedesk/web:1.0.0
# KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.1
# CADDY_IMAGE=caddy:2.10-alpine
# POSTGRES_IMAGE=postgres:16-alpine
# REDIS_IMAGE=redis:7-alpine
# MINIO_IMAGE=...
# MINIO_MC_IMAGE=...

# --- Recursos (límites por contenedor) -----------------------------------------
# API_CPUS=2.0
# API_MEMORY=1G
# WORKER_CPUS=1.5
# WORKER_MEMORY=1G
# DB_CPUS=2.0
# DB_MEMORY=2G
# KC_CPUS=2.0
# KC_MEMORY=1536M
# REDIS_MEMORY=512M
# MINIO_MEMORY=1G
# WEB_MEMORY=512M
# LOG_MAX_SIZE=20m
# LOG_MAX_FILE=5

# --- Copias de seguridad (scripts/backup.sh) --------------------------------
BACKUP_DIR=/var/backups/energuate-sd
BACKUP_RETENTION_DAYS=14
