# =============================================================================
# Energuate Service Desk — variables de entorno LOCAL / LABORATORIO (plantilla)
# (producción: .env.production.example + docker-compose.prod.yml)
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# Sustituya TODOS los valores "replace-..." antes de arrancar. El archivo .env
# está en .gitignore: nunca lo suba al repositorio.
# Docker Compose interpreta "$" en .env: si una contraseña lo contiene, escríbala
# entre comillas simples o duplique el símbolo ($$).
# =============================================================================

# development (laboratorio) | production. Con production la API rechaza AUTH_MODE=dev.
ENVIRONMENT=development

# --- Base de datos de la aplicación (PostgreSQL) ------------------------------
# Use solo letras y números: la contraseña se inserta en DATABASE_URL.
DB_PASSWORD=replace-with-strong-db-password

# --- Keycloak ----------------------------------------------------------------
KC_DB_PASSWORD=replace-with-strong-keycloak-db-password
# Administrador inicial (bootstrap) del realm master. Solo se crea en el primer
# arranque; en un entorno compartido cree un administrador nominal y elimine este.
KC_ADMIN=admin
KC_ADMIN_PASSWORD=replace-with-strong-keycloak-admin-password
# URL pública de Keycloak (define el "iss" de los tokens). Debe coincidir con
# OIDC_ISSUER (sin /realms/...) y con NEXT_PUBLIC_KEYCLOAK_URL.
KC_HOSTNAME=http://localhost:8081
KC_LOG_LEVEL=info

# Grupo (AD o local) -> rol de realm. Formato Grupo:rol separado por comas.
# Roles válidos: admin, agent, approver, requester (requester ya es el rol por defecto).
KC_GROUP_ROLE_MAP=GG-SD-Admins:admin,GG-SD-Agentes:agent,GG-SD-Aprobadores:approver

# URL(s) del portal (csv) para redirect URIs / web origins del cliente
# servicedesk-web; keycloak-config las aplica en cada ejecución.
KC_WEB_URLS=http://localhost:3000

# Usuarios locales de laboratorio, los mismos que los usuarios demo del backend:
# demo.admin, ana.telecom, luis.soc, rosa.redes, marta.aprobadora,
# carlos.solicitante y sofia.solicitante. SOLO entornos aislados. Con false, si
# existen, se deshabilitan. Contraseña común: mínimo 12 caracteres, distinta del
# usuario y del correo.
KC_LAB_USERS=false
KC_LAB_PASSWORD=replace-with-lab-password

# --- Autenticación de la API -------------------------------------------------
# oidc (por defecto): exige JWT de Keycloak.
# dev: SOLO laboratorio aislado; la identidad se toma de los headers
#      X-Dev-User / X-Dev-Roles / X-Dev-Groups sin verificación alguna.
AUTH_MODE=oidc
# Issuer público (lo que ve el navegador) y JWKS interno (red de Docker).
OIDC_ISSUER=http://localhost:8081/realms/energuate
OIDC_JWKS_URL=http://keycloak:8080/realms/energuate/protocol/openid-connect/certs
OIDC_AUDIENCE=servicedesk-api
CORS_ORIGINS=http://localhost:3000

# --- Ejecución de la API y Celery --------------------------------------------
LOG_LEVEL=INFO
CELERY_LOG_LEVEL=info
# Procesos uvicorn (1 en laboratorio).
UVICORN_WORKERS=1
# IPs de proxies cuyas cabeceras X-Forwarded-* se aceptan (csv o *).
FORWARDED_ALLOW_IPS=127.0.0.1
# Archivo de estado de Celery beat (la imagen corre sin root: debe ser escribible).
CELERY_BEAT_SCHEDULE_FILE=/tmp/celerybeat-schedule

# --- Frontend (se incrustan en el build: tras cambiarlas, docker compose build web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=oidc
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8081
NEXT_PUBLIC_KEYCLOAK_REALM=energuate
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=servicedesk-web
# URL del WebSocket (vacío = se deriva de NEXT_PUBLIC_API_URL, p. ej. ws://localhost:8000/ws).
NEXT_PUBLIC_WS_URL=
# Orígenes extra para la CSP del portal, separados por espacio (normalmente vacío).
NEXT_PUBLIC_CSP_EXTRA_SOURCES=

# --- Active Directory de Energuate (federación en Keycloak) ------------------
# Vacío = sin federación (solo usuarios locales). Guía: docs/AD_INTEGRATION.md
# Ejemplos: ldaps://dc01.energuate.local:636  |  ldap://dc01.energuate.local:389 + LDAP_START_TLS=true
LDAP_URL=
# Cuenta de servicio de SOLO LECTURA (DN completo o usuario@dominio).
LDAP_BIND_DN=replace-with-service-account-dn
LDAP_BIND_CREDENTIAL=replace-with-service-account-password
# DN base de usuarios y de grupos.
LDAP_USERS_DN=replace-with-users-base-dn
LDAP_GROUPS_DN=replace-with-groups-base-dn
# Filtros LDAP opcionales (entre paréntesis; use comillas simples en este archivo).
# Ej. solo cuentas habilitadas:
#   LDAP_USER_FILTER='(!(userAccountControl:1.2.840.113556.1.4.803:=2))'
# Ej. solo grupos del Service Desk:
#   LDAP_GROUP_FILTER='(cn=GG-SD-*)'
LDAP_USER_FILTER=
LDAP_GROUP_FILTER=
# true = resuelve grupos anidados de AD (LDAP_MATCHING_RULE_IN_CHAIN).
LDAP_GROUPS_RECURSIVE=false
# StartTLS sobre ldap://389. Con ldaps:// debe ser false.
LDAP_START_TLS=false
# Permite ldap:// sin cifrado (la contraseña viaja en claro). Nunca en producción.
LDAP_ALLOW_INSECURE=false
# Tiempos en milisegundos.
LDAP_CONNECTION_TIMEOUT=10000
LDAP_READ_TIMEOUT=30000
# subtree (incluye OUs hijas) | one (solo el nivel indicado)
LDAP_SEARCH_SCOPE=subtree
LDAP_PAGINATION=true
LDAP_BATCH_SIZE=500
# Sincronización periódica en segundos (-1 la desactiva).
LDAP_FULL_SYNC_PERIOD=86400
LDAP_CHANGED_SYNC_PERIOD=3600
# Importa todos los usuarios al ejecutar keycloak-config (si false, se importan
# al iniciar sesión y en la sincronización periódica).
LDAP_SYNC_USERS_ON_START=false
# Atributo LDAP con el departamento del usuario (Fase 3). Llega al portal como claim
# "department" y se traduce a un departamento con los «Valores del AD» de Administración.
# Vacío = no se mapea el departamento.
LDAP_DEPARTMENT_ATTRIBUTE=department

# --- Seeds de la aplicación --------------------------------------------------
# true crea tickets de ejemplo (solo laboratorio).
SEED_DEMO=false
# Departamento:GrupoAD -> teams.external_group al crear los equipos por defecto.
SEED_TEAM_GROUPS="Telecomunicaciones:GG-SD-Telecomunicaciones,Seguridad de Redes:GG-SD-SeguridadRedes,Ciberseguridad / SOC:GG-SD-SOC,Riesgo y Cumplimiento:GG-SD-Riesgo,Proyectos TI:GG-SD-ProyectosTI,General:GG-SD-General"

# --- Flujos, documentación y tiempo real (opcionales) --------------------------
# URL pública del portal usada en los enlaces de los correos.
APP_PUBLIC_URL=http://localhost:3000
# false = no crear la política «Cambios» ni las reglas de automatización de ejemplo.
SEED_FLOWS_EXAMPLES=true
# Swagger (/docs), ReDoc y /openapi.json. Vacío = activos salvo en producción.
API_DOCS=
# Keycloak omite el claim "groups" si el usuario no tiene grupos. true (recomendado)
# lo interpreta como "sin grupos" y retira las membresías de equipos mapeados.
OIDC_MISSING_GROUPS_AS_EMPTY=true
# WebSocket /ws (valores por defecto; solo cambiar si hay un motivo):
# WS_PING_INTERVAL_SECONDS=25
# WS_QUEUE_SIZE=500
# WS_MAX_CONNECTION_SECONDS=43200
# WS_SEND_TIMEOUT_SECONDS=10
# WS_VISIBILITY_CACHE_SECONDS=30
# WS_REDIS_BACKOFF_MAX_SECONDS=30

# --- Límites anti-abuso (opcionales; valores por defecto recomendados) ---------
# Prioridad máxima que elige quien no es agente al crear un ticket (vacío = sin límite).
REQUESTER_MAX_PRIORITY=high
# Tickets por hora de un usuario que no es agente (0 = sin límite).
TICKETS_PER_USER_HOUR=30
# Cuota de adjuntos por usuario en 24 h (incluye borrados hasta su purga; admin exento).
ATTACHMENT_USER_DAILY_MB=500
ATTACHMENT_USER_DAILY_COUNT=100
# Días sin iniciar sesión tras los que una cuenta deja de recibir avisos y de ser
# elegible como aprobador/asignado (sus roles AD solo se sincronizan al entrar). 0 = nunca.
ACCOUNT_STALE_DAYS=45
# Un token con «kid» desconocido refresca el JWKS como mucho una vez cada N segundos.
OIDC_JWKS_MIN_REFRESH_SECONDS=60
# WebSocket: conexiones por usuario y proceso, mensajes entrantes por minuto y tamaño
# máximo de trama (lo aplica uvicorn --ws-max-size).
WS_MAX_CONNECTIONS_PER_USER=8
WS_CLIENT_MESSAGES_PER_MINUTE=60
WS_MAX_MESSAGE_BYTES=16384

# --- Catálogo, VIP y reportes (Fase 3) ----------------------------------------
# Grupo AD cuyos miembros son VIP (users.vip se actualiza en cada login; los tickets
# que crean quedan marcados como VIP y pueden tener su propio SLA «solo VIP»).
# keycloak-config crea el grupo en Keycloak si no existe.
VIP_GROUP=GG-SD-VIP
# Dominios permitidos para los destinatarios de reportes programados, separados por
# comas (máximo 20 destinatarios por plantilla). Si la variable no está definida, docker
# compose usa energuate.com; definida pero vacía (REPORT_RECIPIENT_DOMAINS=) = cualquier dominio.
REPORT_RECIPIENT_DOMAINS=energuate.com

# --- SLA ---------------------------------------------------------------------
TZ_BUSINESS=America/Guatemala

# --- Adjuntos (MinIO / S3) ---------------------------------------------------
# Credenciales root de MinIO (solo las usa minio-init y la consola :9001).
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-strong-minio-root-password
# Cuenta de servicio de la API, limitada al bucket (la crea minio-init).
# Clave de acceso >= 3 caracteres, secreto >= 8.
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-strong-s3-secret-key
S3_BUCKET=servicedesk-attachments
S3_REGION=us-east-1
# Endpoint interno (API -> MinIO). Los adjuntos se descargan a través de la API
# (sin URLs prefirmadas), por lo que S3_PUBLIC_ENDPOINT no se usa para adjuntos.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
MAX_ATTACHMENT_MB=20
# Días que se conservan en MinIO los adjuntos borrados antes de purgarlos (0 = nunca).
ATTACHMENT_PURGE_DAYS=30

# --- Correo (notificaciones) -------------------------------------------------
# SMTP_HOST vacío = notificaciones solo dentro de la aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=servicedesk@localhost
SMTP_STARTTLS=true
